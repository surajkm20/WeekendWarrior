# Copy this file to .env and fill in your values
# Never commit .env to git

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your Telegram chat ID (get it from @userinfobot on Telegram)
TELEGRAM_CHAT_ID=your_chat_id_here

# How often to check for tickets (in minutes)
POLL_INTERVAL_MINUTES=5

# The URL to monitor
TICKET_URL=https://shop.royalchallengers.com/ticket

# Your mobile number for RCB shop login (without +91)
MOBILE_NUMBER=91XXXXXXXXXX

# Number of tickets to book
TICKET_QUANTITY=1

# Seat price range — only book seats within this range (in ₹)
# Blocks A–D are tried in order (A = closest to ground, highest priority)
MIN_TICKET_PRICE=3500
MAX_TICKET_PRICE=5000
